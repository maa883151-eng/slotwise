# Copy this file to .env.local and fill in real values for local development:
#   cp .env.example .env.local
#
# In production (Vercel), set these as real environment variables in the
# project settings instead of committing a .env file. If AUTH_SECRET or
# ADMIN_PASSWORD are missing in a production-like environment (NODE_ENV
# production or any VERCEL_ENV), the admin panel refuses to start with an
# insecure default — see lib/adminSession.ts.

# Secret used to sign the admin session cookie (HMAC-SHA256).
# Generate one locally, e.g.: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Password required to log into /admin.
ADMIN_PASSWORD=replace-with-a-strong-password
